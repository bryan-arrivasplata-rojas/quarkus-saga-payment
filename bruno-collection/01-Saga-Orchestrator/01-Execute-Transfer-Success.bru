meta {
  name: 01. Ejecutar Transferencia (Happy Path)
  type: http
  seq: 1
}

post {
  url: {{orchestrator_url}}/api/transfers
  body: json
  auth: none
}

body:json {
  {
    "fromAccountId": 1,
    "toAccountId": 2,
    "amount": 50.00,
    "simulateNotificationFailure": false
  }
}

assert {
  res.status: eq 200
  res.body.status: eq SUCCESS
}
